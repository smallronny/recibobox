{
  "name": "recibo-box-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo: backend (Node/Express + TypeORM) + frontend (Angular)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run start -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "db:init": "npm run db:init -w backend"
  }
}
